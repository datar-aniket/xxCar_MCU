# The init task is ours, not NuttX's nsh_main.
#
# nsh_main unconditionally takes /dev/console and runs a shell on it, which made
# TELEM1's shell impossible to turn off: assign TELEM1 to MAVLink and you got
# MAVLink AND a shell fighting over the same UART. apps/init runs the console
# shell only if the console's port is actually set to NSH (SER_TEL1_FUNC).
#
# The symbol is <PROGNAME>_main, exactly as "nsh" yields nsh_main.
#
# Board init is unaffected: it runs from board_late_initialize() -> stm32_bringup(),
# driven by the OS regardless of which task is init (board_app_initialize() is
# already a no-op under CONFIG_BOARD_LATE_INITIALIZE).
CONFIG_INIT_ENTRYPOINT="xxcar_init_main"

# Stack for the NSH console task. Raised from the 2048 default because `ps`
# OVERFLOWED IT and reset the board with no crash dump.
#
# `ps` is an NSH *internal* command, so it runs on this stack, not on one of its
# own. nsh_foreach_direntry() puts a struct dirent on it (d_name alone is
# NAME_MAX+1 = 256 bytes), ps_record()/ps_output() nest on top, and
# LIBC_FLOATINGPOINT makes the printf path stack-hungry too. The failure is
# silent because the assert handler needs stack of its own and has none left -
# the same signature as the uorb_listener reboot we chased earlier.
CONFIG_INIT_STACKSIZE=4096

# Paint every stack at creation so NuttX can SEE how deep a task actually went.
# Without this, `ps` cannot report stack used (only the size), and an overflow is
# undetectable: it just corrupts memory and the board resets with nothing printed.
# We have now been bitten by that twice. The cost is a memset per task creation.
