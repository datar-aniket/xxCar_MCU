# System tick = 1 kHz (1000 us/tick). Raised from the NuttX default 100 Hz for
# two reasons: (1) 1 ms usleep granularity for future higher-rate periodic tasks
# (control loops, polled sensors); (2) it makes the SYSCLK CPU-load sampler 10x
# finer, shrinking the tick-phase-locking artifact where periodic threads that
# wake on a tick boundary get over-credited a whole tick of CPU. The H7 @480 MHz
# handles a 1 kHz tick trivially (PX4 runs the same).
CONFIG_USEC_PER_TICK=1000

# CPU-load accounting via SYSCLK tick-sampling. TICKSPERSEC MUST equal the system
# tick rate (1e6/USEC_PER_TICK = 1000 Hz): the sampler re-arms every
# (TICK_PER_SEC/TICKSPERSEC) ticks, so any value > the tick rate floors that
# period to 0 -> a 0-tick self-rearming watchdog that spins forever in the timer
# ISR and HARD-HANGS the board. You cannot sample CPU load faster than the tick.
# NOTE: even at 1 kHz this remains a sampling estimate, not exact per-thread
# cycle accounting; treat single-thread % for tick-aligned periodic threads as
# an upper bound (the DWT/CRITMONITOR alternative faulted at boot on this H7).
CONFIG_SCHED_CPULOAD_SYSCLK=y
CONFIG_SCHED_CPULOAD_TICKSPERSEC=1000

CONFIG_CDCACM=y
CONFIG_SYSTEM_CDCACM=y
CONFIG_SYSTEM_CDCACM_DEVMINOR=0
CONFIG_SERIAL_REMOVABLE=y

# SPI1 DMA for the IMU bus. Polled H7 SPI does a CSTART/CSUSP handshake PER BYTE
# (real CPU on every byte of an IMU burst); DMA turns a burst into one hardware
# transfer while the thread sleeps on a completion semaphore (~0% CPU). Required
# for the ICM-42688-P FIFO+DRDY 2 kHz streaming (watermark reads are hundreds of
# bytes). The driver bounces through a static AXI-SRAM buffer (.bss is at
# 0x24000000, DMA-accessible) with cache clean/invalidate, so caller buffers may
# live anywhere (incl. DTCM). SPI1_DMA selects STM32H7_SPI_DMA and needs a DMA
# controller enabled; the 512 B bounce buffer covers a full FIFO watermark read.
CONFIG_STM32H7_DMA1=y
CONFIG_STM32H7_DMA2=y
CONFIG_STM32H7_SPI1_DMA=y
CONFIG_STM32H7_SPI1_DMA_BUFFER=512