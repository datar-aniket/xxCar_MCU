# Serial ports ---------------------------------------------------------------
# Every FMUv6C connector's UART is enabled, because which port does what is a
# runtime decision (the SER_*_FUNC parameters), not a build-time one.
#
# DISABLE_REORDERING is the load-bearing setting. By default NuttX renumbers the
# serial devices so the console becomes /dev/ttyS0, which means every other
# port's index depends on which peripherals are enabled and shifts whenever that
# changes. The parameter system hands out device names, so the mapping has to be
# stable. With reordering disabled, ttySn follows plain peripheral order:
#
#   USART1 ttyS0 GPS1 | USART2 ttyS1 TELEM3 | USART3 ttyS2 FMU DEBUG
#   UART5  ttyS3 TELEM2 | USART6 ttyS4 PX4IO | UART7 ttyS5 TELEM1 | UART8 ttyS6 GPS2
#
# See boards/fmuv6c/include/board.h for the pin map.
CONFIG_STM32H7_SERIAL_DISABLE_REORDERING=y
CONFIG_STM32H7_USART1=y
CONFIG_STM32H7_USART2=y
CONFIG_STM32H7_USART3=y
CONFIG_STM32H7_UART5=y
CONFIG_STM32H7_USART6=y
CONFIG_STM32H7_UART7=y
CONFIG_STM32H7_UART8=y

# TELEM1 is the NSH console at boot. This is only the *default*: SER_TEL1_FUNC
# and its siblings can move NSH to any other port at runtime.
CONFIG_UART7_SERIAL_CONSOLE=y
CONFIG_UART7_BAUD=115200

CONFIG_USART1_BAUD=115200
CONFIG_USART2_BAUD=115200
CONFIG_USART3_BAUD=115200
CONFIG_UART5_BAUD=115200
CONFIG_UART8_BAUD=115200

# USART6 is the PX4IO co-processor link. 1.5 Mbaud is not a preference: it is
# what the IO firmware already on the chip runs at (PX4's PX4IO_SERIAL_BITRATE).
# The RX buffer must hold a whole IOPacket (68 bytes) plus slack, since the
# reply arrives as one uninterrupted burst ~426us long.
CONFIG_USART6_BAUD=1500000
CONFIG_USART6_RXBUFSIZE=256
CONFIG_USART6_TXBUFSIZE=256

# RX DMA on the IO link, so a 400 Hz servo update rate stays cheap.
#
# At 1.5 Mbaud a byte arrives every 6.7us. Interrupt-driven, IO's ~52-byte reply
# costs an IRQ every time the 8-deep hardware FIFO crosses its threshold; at
# 400 Hz that is thousands of interrupts per second just to service one link.
# With RX DMA the controller writes the whole burst to memory unaided and the
# USART's IDLE-line interrupt hands it over in ONE go once the line falls quiet
# (stm32_serial.c only enables USART_CR1_IDLEIE when RX DMA is compiled in) --
# roughly two interrupts per exchange instead of a dozen. It is the same
# mechanism PX4 uses on this link.
#
# The RXDMA symbols do not exist in upstream NuttX 12.13.0: the H7 serial driver
# implements RX/TX DMA in full but its Kconfig never declared the options, so the
# code was unreachable. patches/nuttx/0002 restores them (stm32f7 has them).
#
# TX DMA is deliberately left off: our request is only 4-20 bytes, which the
# hardware FIFO already absorbs in one go, so DMA would burn a second DMA1
# stream for no measurable gain. The burst is entirely in the RX direction.
CONFIG_USART6_RXDMA=y

# One whole IOPacket (68 bytes) must fit, with room to spare, so a reply is never
# split across a buffer wrap. Rounded up to a multiple of the 32-byte cache line.
CONFIG_STM32H7_SERIAL_RXDMA_BUFFER_SIZE=128

# NOTE: CONFIG_STM32H7_FDCAN1 is deliberately NOT set.
#
# That symbol exists only to build NuttX's stm32_fdcan_sock.c, which is a
# SocketCAN driver and does not compile without CONFIG_NET - enabling it
# alone fails on arm_netinitialize and NET_LL_CAN. Our driver needs nothing
# from it: boards/fmuv6c/src/fdcan.c enables the peripheral clock, configures
# the pins and touches the registers itself, and the FDCAN kernel clock is
# already selected from STM32_RCC_D2CCIP1R_FDCANSEL in board.h regardless of
# any CONFIG symbol.
#
# PX4 arrives at the same place on this silicon: their fmu-v6c has no
# CONFIG_NET, no NET_CAN and no CAN, and drives FDCAN directly.


# RTC clocked from HSE, matching PX4's own fmu-v6c configuration.
#
# NOT LSE. board.h defines STM32_LSE_FREQUENCY, but that is a frequency
# DECLARATION, not evidence of a part: this board does not populate the
# 32.768 kHz crystal. Selecting LSECLOCK enables the oscillator, waits out
# its bounded timeout, and then leaves the RTC clocked by something that
# never starts - after which the first register read hard-faults with the
# console not yet up, which is a silent brick. PX4 uses HSECLOCK here for
# exactly this reason.
#
# NuttX divides HSE down itself: HSE_DIVISOR is derived from
# STM32_HSE_FREQUENCY (16 MHz -> /16 -> 1 MHz), so there is nothing to
# configure in board.h.
#
# WHAT THIS COSTS: HSE is the main oscillator and does not run in VBAT mode.
# The RTC therefore survives a warm reboot, where the backup domain is not
# reset, but NOT a power cycle. "Sync once" means once per power-up, not
# once ever. Only an LSE crystal with a backup cell gives the latter, and
# this board has neither.
#
# MAGIC_REG=1 also follows PX4: a backup register NuttX stamps once the RTC
# has actually been set, so a cold RTC is known to be unset rather than read
# as a plausible-looking date that was never true.
CONFIG_STM32H7_PWR=y
CONFIG_STM32H7_RTC=y
CONFIG_STM32H7_RTC_HSECLOCK=y
CONFIG_STM32H7_RTC_MAGIC_REG=1
CONFIG_RTC=y
CONFIG_RTC_DATETIME=y
CONFIG_RTC_DRIVER=y



# RX DMA on the TELEM ports the companion link can be assigned to.
#
# The companion sends 53-byte frames and the board answers with 61-byte ones.
# Interrupt-driven, each frame is several IRQs as the 8-deep FIFO fills, and
# every one of them lands between the estimator's 400 Hz packets. That is not
# a throughput problem - it is a JITTER problem, and jitter on this link turns
# directly into position error once a pose carries a timestamp.
#
# With RX DMA the controller writes the whole frame to memory unaided and the
# IDLE-line interrupt hands it over once, so a frame costs about two
# interrupts instead of a dozen. Same mechanism as the PX4IO link above.
#
# TELEM1 is deliberately NOT included. It carries the boot console, and the
# console is the thing you need working when something else is not - changing
# how it takes bytes is not worth the risk for a port the companion does not
# have to use. Add CONFIG_UART7_RXDMA=y if you want it there and are willing
# to test the shell afterwards.
#
# TX is left interrupt-driven. The outgoing frame is 61 bytes, which the FIFO
# absorbs in one go, so DMA would claim a stream per port for no measurable
# gain - the same argument USART6 makes above.
CONFIG_UART5_RXDMA=y
CONFIG_USART2_RXDMA=y

# Big enough that a whole frame plus slack never wraps mid-message. The RX DMA
# buffer size is shared by every port that uses it.
CONFIG_UART5_RXBUFSIZE=256
CONFIG_UART5_TXBUFSIZE=256
CONFIG_USART2_RXBUFSIZE=256
CONFIG_USART2_TXBUFSIZE=256


# The 8-deep RX FIFO is always enabled by the H7 driver; this only sets when it
# raises an interrupt. 1/4 full (2 bytes) keeps latency low for the 4-byte packet
# header, and with RX DMA doing the bulk transfer the threshold is not the thing
# carrying the data anyway.
CONFIG_USART6_RXFIFO_THRES=1

# System tick = 1 kHz (1000 us/tick). Raised from the NuttX default 100 Hz for
# two reasons: (1) 1 ms usleep granularity for future higher-rate periodic tasks
# (control loops, polled sensors); (2) it makes the SYSCLK CPU-load sampler 10x
# finer, shrinking the tick-phase-locking artifact where periodic threads that
# wake on a tick boundary get over-credited a whole tick of CPU. The H7 @480 MHz
# handles a 1 kHz tick trivially (PX4 runs the same).
CONFIG_USEC_PER_TICK=1000

