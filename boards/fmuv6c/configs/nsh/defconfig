# SPI1 DMA for the IMU bus. Polled H7 SPI does a CSTART/CSUSP handshake PER BYTE
# (real CPU on every byte of an IMU burst); DMA turns a burst into one hardware
# transfer while the thread sleeps on a completion semaphore (~0% CPU). Required
# for the ICM-42688-P FIFO+DRDY 2 kHz streaming (watermark reads are hundreds of
# bytes). The driver bounces through a static AXI-SRAM buffer (.bss is at
# 0x24000000, DMA-accessible) with cache clean/invalidate, so caller buffers may
# live anywhere (incl. DTCM). SPI1_DMA selects STM32H7_SPI_DMA and needs a DMA
# controller enabled; the 512 B bounce buffer covers a full FIFO watermark read.
CONFIG_STM32H7_DMA1=y
CONFIG_STM32H7_DMA2=y
CONFIG_STM32H7_SPI1_DMA=y
CONFIG_STM32H7_SPI1_DMA_BUFFER=512

# Crash/hang recovery. Two independent layers, because they catch different
# failures:
#
# 1. BOARD_RESET_ON_ASSERT=1 -> reset only on a KERNEL panic: an assert from an
#    interrupt handler or a kernel thread calls board_reset(). A crash in a
#    plain user thread does NOT reboot the board - NuttX just kills that thread
#    and the system keeps running (=2 would reset for user threads too, which
#    is too aggressive: one bad app shouldn't take the vehicle down).
#
# 2. IWDG hardware watchdog -> catches HANGS, where nothing asserts and the
#    system just stops making progress (e.g. a spin inside the timer ISR). The
#    IWDG is independent of the main clock and can only be stopped by a reset.
#    It is auto-fed BY_WORKER (a low-priority work-queue task) rather than from
#    a timer ISR on purpose: that proves the SCHEDULER is still alive, so a task
#    spinning and starving the system still trips the watchdog. A 2 s timeout
#    (fed every 1 s) is far longer than any legitimate stall at our ~8% load.
#    NOTE: the IWDG runs off the ~32 kHz LSI with a 12-bit reload, so its max
#    timeout is ~32 s - the 60 s Kconfig default would be unreachable.
CONFIG_BOARD_RESET_ON_ASSERT=1
CONFIG_SCHED_LPWORK=y
CONFIG_STM32H7_IWDG=y
CONFIG_WATCHDOG_AUTOMONITOR=y
CONFIG_WATCHDOG_AUTOMONITOR_BY_WORKER=y
CONFIG_WATCHDOG_AUTOMONITOR_TIMEOUT=2000

# microSD on SDMMC2 (4-bit SDIO, internal DMA) -> /dev/mmcsd0, mounted FAT at
# /fs/microsd at boot. This is the store for logs, params and config, and the
# volume exported over USB mass storage. No card-detect line on the FMUv6C, so
# MMCSD_HAVE_CARDDETECT stays off and the board reports the card present.
# The SDMMC driver's media-change callback support requires the HIGH-priority
# work queue specifically (LPWORK alone is not enough).
CONFIG_SCHED_HPWORK=y
CONFIG_STM32H7_SDMMC2=y
CONFIG_STM32H7_SDMMC_IDMA=y
# Keep DTCM out of the general heap. The SDMMC IDMA cannot reach Tightly
# Coupled Memory at all - DTCM is private to the core - and NuttX says so
# itself in stm32_allocateheap.c ("DMA transfers to/from DTCM are limited"),
# which is what CONFIG_STM32H7_DTCMEXCLUDE exists for. Without it an ordinary
# kmm_malloc() can return a sector-sized buffer at 0x2000xxxx that FAT or
# usbmsc then hands straight to the block driver.
#
# patches/nuttx/0003 makes the driver refuse such a buffer instead of silently
# transferring from the wrong address, but a refusal is only recoverable where
# the caller has a fallback: FAT retries through its DMA pool, usbmsc has no
# retry and would simply fail to export the card. Excluding the region means
# no allocation lands there in the first place; the driver check stays as the
# backstop. Costs 128 KB of a ~880 KB heap.
#
# MM_REGIONS drops 4 -> 3: AXI SRAM, SRAM123, SRAM4. DTCM was the fourth, and
# nothing is linked into it (flash.ld declares dtcm1/dtcm2 but places no
# output section there). SPI1 is unaffected - it already bounces through a
# static AXI-SRAM buffer, so its callers may still pass anything.
CONFIG_STM32H7_DTCMEXCLUDE=y
CONFIG_MMCSD=y
CONFIG_MMCSD_SDIO=y
CONFIG_MMCSD_SDIOWAIT_WRCOMPLETE=y
# This board has an SDIO microSD only: no card-detect, no write-protect, no
# SPI-attached card and no eMMC. Leaving these Kconfig defaults on would pull in
# the SPI MMC path (which wants a stm32_mmcsd_initialize() we don't have).
# CONFIG_MMCSD_SPI is not set
# CONFIG_MMCSD_HAVE_CARDDETECT is not set
# CONFIG_MMCSD_HAVE_WRITEPROTECT is not set
# CONFIG_MMCSD_MMCSUPPORT is not set
CONFIG_FS_FAT=y
# FAT sector buffers from a DMA-capable, 64-byte-aligned granule pool, and the
# indirect-transfer fallback it selects (CONFIG_FAT_DIRECT_RETRY). Every
# in-tree STM32H7 board with an SDMMC card sets this; we did not, so a direct
# multi-sector write the IDMA rejected became a hard write failure with no
# retry - which the logger then turned into a torn record.
CONFIG_FAT_DMAMEMORY=y
CONFIG_FAT_LFN=y
CONFIG_FS_FATTIME=y

# On-target SD validation tools. sdbench exercises aligned sequential IDMA
# reads/writes and reports throughput, maximum request latency and fsync time.
# sdstress repeatedly verifies FAT create/write/read/rename/delete integrity.
CONFIG_BENCHMARK_SD_BENCH=y
CONFIG_BENCHMARK_SD_BENCH_DEVICE="/fs/microsd"
CONFIG_TESTING_SD_MEM_ALIGN_BYTES=32
CONFIG_TESTING_SD_STRESS=y
CONFIG_TESTING_SD_STRESS_DEVICE="/fs/microsd"
CONFIG_XXCAR_SD_STATUS=y
