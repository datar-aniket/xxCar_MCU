# Serial ports ---------------------------------------------------------------
# Every FMUv6C connector's UART is enabled, because which port does what is a
# runtime decision (the SER_*_FUNC parameters), not a build-time one.
#
# DISABLE_REORDERING is the load-bearing setting. By default NuttX renumbers the
# serial devices so the console becomes /dev/ttyS0, which means every other
# port's index depends on which peripherals are enabled and shifts whenever that
# changes. The parameter system hands out device names, so the mapping has to be
# stable. With reordering disabled, ttySn follows plain peripheral order:
#
#   USART1 ttyS0 GPS1 | USART2 ttyS1 TELEM3 | USART3 ttyS2 FMU DEBUG
#   UART5  ttyS3 TELEM2 | USART6 ttyS4 PX4IO | UART7 ttyS5 TELEM1 | UART8 ttyS6 GPS2
#
# See boards/fmuv6c/include/board.h for the pin map.
CONFIG_STM32H7_SERIAL_DISABLE_REORDERING=y
CONFIG_STM32H7_USART1=y
CONFIG_STM32H7_USART2=y
CONFIG_STM32H7_USART3=y
CONFIG_STM32H7_UART5=y
CONFIG_STM32H7_USART6=y
CONFIG_STM32H7_UART7=y
CONFIG_STM32H7_UART8=y

# TELEM1 is the NSH console at boot. This is only the *default*: SER_TEL1_FUNC
# and its siblings can move NSH to any other port at runtime.
CONFIG_UART7_SERIAL_CONSOLE=y
CONFIG_UART7_BAUD=115200

CONFIG_USART1_BAUD=115200
CONFIG_USART2_BAUD=115200
CONFIG_USART3_BAUD=115200
CONFIG_UART5_BAUD=115200
CONFIG_UART8_BAUD=115200

# USART6 is the PX4IO co-processor link. 1.5 Mbaud is not a preference: it is
# what the IO firmware already on the chip runs at (PX4's PX4IO_SERIAL_BITRATE).
# The RX buffer must hold a whole IOPacket (68 bytes) plus slack, since the
# reply arrives as one uninterrupted burst ~426us long.
CONFIG_USART6_BAUD=1500000
CONFIG_USART6_RXBUFSIZE=256
CONFIG_USART6_TXBUFSIZE=256

# System tick = 1 kHz (1000 us/tick). Raised from the NuttX default 100 Hz for
# two reasons: (1) 1 ms usleep granularity for future higher-rate periodic tasks
# (control loops, polled sensors); (2) it makes the SYSCLK CPU-load sampler 10x
# finer, shrinking the tick-phase-locking artifact where periodic threads that
# wake on a tick boundary get over-credited a whole tick of CPU. The H7 @480 MHz
# handles a 1 kHz tick trivially (PX4 runs the same).
CONFIG_USEC_PER_TICK=1000

# CPU-load accounting via SYSCLK tick-sampling. TICKSPERSEC MUST equal the system
# tick rate (1e6/USEC_PER_TICK = 1000 Hz): the sampler re-arms every
# (TICK_PER_SEC/TICKSPERSEC) ticks, so any value > the tick rate floors that
# period to 0 -> a 0-tick self-rearming watchdog that spins forever in the timer
# ISR and HARD-HANGS the board. You cannot sample CPU load faster than the tick.
# NOTE: even at 1 kHz this remains a sampling estimate, not exact per-thread
# cycle accounting; treat single-thread % for tick-aligned periodic threads as
# an upper bound (the DWT/CRITMONITOR alternative faulted at boot on this H7).
CONFIG_SCHED_CPULOAD_SYSCLK=y
CONFIG_SCHED_CPULOAD_TICKSPERSEC=1000

CONFIG_CDCACM=y
CONFIG_SERIAL_REMOVABLE=y

# USB = permanent CDC/ACM + Mass Storage composite. The CDC serial data port is
# always enumerated, so it never disappears. Only the mass-storage MEDIA is
# toggled at runtime (see boards/fmuv6c/src/stm32_composite.c):
#
#   boot      -> SD mounted locally at /fs/microsd; the MSC LUN is left UNBOUND
#                so the host sees "no medium" and cannot touch the card.
#   sdmsc on  -> unmount locally, THEN bind the LUN: the host owns the card.
#   sdmsc off -> unbind the LUN, THEN remount locally.
#
# Binding the LUN at composite-connect time (as the reference boards do) would
# export the card while NuttX still had it mounted - Linux would auto-mount it
# and both sides would write the same FAT. Exactly one owner at a time.
#
# VID/PID are kept at the Stage 1 values so the existing udev rule still binds.
# SYSTEM_CDCACM (sercon/serdis) is dropped: it calls cdcacm_initialize() for a
# STANDALONE CDC device, which conflicts with the composite.
CONFIG_USBDEV_COMPOSITE=y
CONFIG_COMPOSITE_IAD=y
CONFIG_CDCACM_COMPOSITE=y
CONFIG_USBMSC=y
CONFIG_USBMSC_COMPOSITE=y
CONFIG_USBMSC_REMOVABLE=y
CONFIG_COMPOSITE_VENDORID=0x3162
CONFIG_COMPOSITE_PRODUCTID=0x0053
CONFIG_COMPOSITE_VENDORSTR="Holybro"
CONFIG_COMPOSITE_PRODUCTSTR="Pixhawk6C xxCar"

# Mass-storage bulk transfer sizing. These Kconfig values default to 512 only
# when USBDEV_DUALSPEED is set; our OTG_FS is full-speed only, so they silently
# fall back to the 64-byte MINIMUM. That dribbles every 512-byte sector through
# 8 tiny USB requests and bulk copies crawl to ~0 B/s (small directory reads
# still work, which makes it look like a glitch rather than a config problem).
# NuttX's own help says the request buffer should be one block-device sector.
CONFIG_USBMSC_BULKINREQLEN=512
CONFIG_USBMSC_BULKOUTREQLEN=512
CONFIG_USBMSC_NRDREQS=8
CONFIG_USBMSC_NWRREQS=8

# Our out-of-tree apps (apps/ -> nuttx-apps/xxcar symlink, made by build.sh)
CONFIG_XXCAR_SDMSC=y
CONFIG_XXCAR_PARAM=y
CONFIG_XXCAR_PX4IO=y

# SPI1 DMA for the IMU bus. Polled H7 SPI does a CSTART/CSUSP handshake PER BYTE
# (real CPU on every byte of an IMU burst); DMA turns a burst into one hardware
# transfer while the thread sleeps on a completion semaphore (~0% CPU). Required
# for the ICM-42688-P FIFO+DRDY 2 kHz streaming (watermark reads are hundreds of
# bytes). The driver bounces through a static AXI-SRAM buffer (.bss is at
# 0x24000000, DMA-accessible) with cache clean/invalidate, so caller buffers may
# live anywhere (incl. DTCM). SPI1_DMA selects STM32H7_SPI_DMA and needs a DMA
# controller enabled; the 512 B bounce buffer covers a full FIFO watermark read.
CONFIG_STM32H7_DMA1=y
CONFIG_STM32H7_DMA2=y
CONFIG_STM32H7_SPI1_DMA=y
CONFIG_STM32H7_SPI1_DMA_BUFFER=512

# Crash/hang recovery. Two independent layers, because they catch different
# failures:
#
# 1. BOARD_RESET_ON_ASSERT=1 -> reset only on a KERNEL panic: an assert from an
#    interrupt handler or a kernel thread calls board_reset(). A crash in a
#    plain user thread does NOT reboot the board - NuttX just kills that thread
#    and the system keeps running (=2 would reset for user threads too, which
#    is too aggressive: one bad app shouldn't take the vehicle down).
#
# 2. IWDG hardware watchdog -> catches HANGS, where nothing asserts and the
#    system just stops making progress (e.g. a spin inside the timer ISR). The
#    IWDG is independent of the main clock and can only be stopped by a reset.
#    It is auto-fed BY_WORKER (a low-priority work-queue task) rather than from
#    a timer ISR on purpose: that proves the SCHEDULER is still alive, so a task
#    spinning and starving the system still trips the watchdog. A 2 s timeout
#    (fed every 1 s) is far longer than any legitimate stall at our ~8% load.
#    NOTE: the IWDG runs off the ~32 kHz LSI with a 12-bit reload, so its max
#    timeout is ~32 s - the 60 s Kconfig default would be unreachable.
CONFIG_BOARD_RESET_ON_ASSERT=1
CONFIG_SCHED_LPWORK=y
CONFIG_STM32H7_IWDG=y
CONFIG_WATCHDOG_AUTOMONITOR=y
CONFIG_WATCHDOG_AUTOMONITOR_BY_WORKER=y
CONFIG_WATCHDOG_AUTOMONITOR_TIMEOUT=2000

# microSD on SDMMC2 (4-bit SDIO, internal DMA) -> /dev/mmcsd0, mounted FAT at
# /fs/microsd at boot. This is the store for logs, params and config, and the
# volume exported over USB mass storage. No card-detect line on the FMUv6C, so
# MMCSD_HAVE_CARDDETECT stays off and the board reports the card present.
# The SDMMC driver's media-change callback support requires the HIGH-priority
# work queue specifically (LPWORK alone is not enough).
CONFIG_SCHED_HPWORK=y
CONFIG_STM32H7_SDMMC2=y
CONFIG_STM32H7_SDMMC_IDMA=y
CONFIG_MMCSD=y
CONFIG_MMCSD_SDIO=y
CONFIG_MMCSD_SDIOWAIT_WRCOMPLETE=y
# This board has an SDIO microSD only: no card-detect, no write-protect, no
# SPI-attached card and no eMMC. Leaving these Kconfig defaults on would pull in
# the SPI MMC path (which wants a stm32_mmcsd_initialize() we don't have).
# CONFIG_MMCSD_SPI is not set
# CONFIG_MMCSD_HAVE_CARDDETECT is not set
# CONFIG_MMCSD_HAVE_WRITEPROTECT is not set
# CONFIG_MMCSD_MMCSUPPORT is not set
CONFIG_FS_FAT=y
CONFIG_FAT_LFN=y
CONFIG_FS_FATTIME=y