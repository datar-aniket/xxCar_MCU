diff --git a/arch/arm/src/armv7-m/arm_perf.c b/arch/arm/src/armv7-m/arm_perf.c
--- a/arch/arm/src/armv7-m/arm_perf.c
+++ b/arch/arm/src/armv7-m/arm_perf.c
@@ -26,10 +26,10 @@
 
 #include <nuttx/arch.h>
 #include <nuttx/clock.h>
+#include <arch/barriers.h>
 
 #include "arm_internal.h"
 #include "dwt.h"
-#include "itm.h"
 #include "nvic.h"
 
 #ifdef CONFIG_ARCH_HAVE_PERF_EVENTS
@@ -40,24 +40,106 @@
 
 static unsigned long g_cpu_freq = ULONG_MAX;
 
+#ifdef CONFIG_DEBUG_FEATURES
+static void arm_perf_puthex(uint32_t value)
+{
+  static const char hex[] = "0123456789abcdef";
+  int shift;
+
+  for (shift = 28; shift >= 0; shift -= 4)
+    {
+      arm_lowputc(hex[(value >> shift) & 0xf]);
+    }
+}
+#endif
+
 /****************************************************************************
  * Public Functions
  ****************************************************************************/
 
 void up_perf_init(void *arg)
 {
+  uint32_t ctrl;
+  uint32_t numcomp;
+  uint32_t i;
+
+#ifdef CONFIG_DEBUG_FEATURES
+  arm_lowputc('F');
+#endif
+
   g_cpu_freq = (unsigned long)(uintptr_t)arg;
 
+#ifdef CONFIG_DEBUG_FEATURES
+  arm_lowputc('G');
+#endif
+
   /* Enable ITM and DWT resources, if not left enabled by debugger. */
 
   modifyreg32(NVIC_DEMCR, 0, NVIC_DEMCR_TRCENA);
 
+#ifdef CONFIG_DEBUG_FEATURES
+  arm_lowputc('R');
+#endif
+
   /* Make sure the high speed cycle counter is running.  It will be started
    * automatically only if a debugger is connected.
    */
 
-  putreg32(0xc5acce55, ITM_LAR);
-  modifyreg32(DWT_CTRL, 0, DWT_CTRL_CYCCNTENA_MASK);
+  DWT_GRANT_ACCESS();
+
+  ctrl = getreg32(DWT_CTRL);
+  numcomp = (ctrl & DWT_CTRL_NUMCOMP_MASK) >> DWT_CTRL_NUMCOMP_SHIFT;
+  if (numcomp > 4)
+    {
+      numcomp = 4;
+    }
+
+#ifdef CONFIG_DEBUG_FEATURES
+  arm_lowputc('N');
+  arm_perf_puthex(getreg32(NVIC_DHCSR));
+  arm_lowputc('M');
+  arm_perf_puthex(getreg32(NVIC_DEMCR));
+
+  for (i = 0; i < numcomp; i++)
+    {
+      arm_lowputc('0' + i);
+      arm_perf_puthex(getreg32(DWT_FUNCTION0 + 16 * i));
+    }
+#endif
+
+  /* A bootloader or debugger can leave DWT comparators and trace/event
+   * controls armed across the application handoff.  Disable every comparator
+   * before changing its match registers, then take exclusive ownership of
+   * DWT_CTRL for the cycle counter.
+   */
+
+  for (i = 0; i < numcomp; i++)
+    {
+      putreg32(0, DWT_FUNCTION0 + 16 * i);
+    }
+
+  for (i = 0; i < numcomp; i++)
+    {
+      putreg32(0, DWT_COMP0 + 16 * i);
+      putreg32(0, DWT_MASK0 + 16 * i);
+    }
+
+  putreg32(0, DWT_CYCCNT);
+
+#ifdef CONFIG_DEBUG_FEATURES
+  arm_lowputc('I');
+  arm_lowputc('Q');
+  arm_lowputc('q');
+#endif
+
+  putreg32(DWT_CTRL_CYCCNTENA_MASK, DWT_CTRL);
+  UP_DSB();
+  UP_ISB();
+
+#ifdef CONFIG_DEBUG_FEATURES
+  arm_lowputc('W');
+  arm_lowputc('w');
+#endif
 }
 
 unsigned long up_perf_getfreq(void)
