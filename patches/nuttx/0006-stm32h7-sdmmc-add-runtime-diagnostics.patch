diff --git a/arch/arm/src/stm32h7/stm32_sdmmc.h b/arch/arm/src/stm32h7/stm32_sdmmc.h
--- a/arch/arm/src/stm32h7/stm32_sdmmc.h
+++ b/arch/arm/src/stm32h7/stm32_sdmmc.h
@@ -30,6 +30,7 @@
 #include <nuttx/config.h>
 #include <sys/types.h>
 #include <stdbool.h>
+#include <stdint.h>
 
 #include "chip.h"
 #include "hardware/stm32_sdmmc.h"
@@ -67,6 +68,31 @@ extern "C"
 struct sdio_dev_s; /* See include/nuttx/sdio.h */
 struct sdio_dev_s *sdio_initialize(int slotno);
 
+/* Lightweight controller diagnostics.  Counters are accumulated by the
+ * transfer setup and error paths and do not add timestamps or logging to the
+ * normal SDMMC path.
+ */
+
+struct stm32_sdmmc_stats_s
+{
+  uint32_t clkcr;
+  uint32_t status;
+  uint32_t idmactrl;
+  uint32_t read_transfers;
+  uint32_t write_transfers;
+  uint64_t read_bytes;
+  uint64_t write_bytes;
+  uint32_t bounced_reads;
+  uint32_t data_crc_errors;
+  uint32_t data_timeouts;
+  uint32_t rx_overruns;
+  uint32_t tx_underruns;
+};
+
+int stm32_sdmmc_getstats(struct sdio_dev_s *dev,
+                         struct stm32_sdmmc_stats_s *stats,
+                         bool reset);
+
