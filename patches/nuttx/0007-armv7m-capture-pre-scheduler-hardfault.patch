+  [2] = &exception_common,
+  [NVIC_IRQ_HARDFAULT] = &arm_early_hardfault,
+  [(NVIC_IRQ_HARDFAULT + 1) ... NVIC_IRQ_PENDSV] = &exception_common,
   [(NVIC_IRQ_PENDSV + 1) ... (15 + ARMV7M_PERIPHERAL_INTERRUPTS)]
