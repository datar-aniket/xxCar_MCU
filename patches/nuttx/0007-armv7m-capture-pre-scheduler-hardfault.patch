diff --git a/arch/arm/src/armv7-m/arm_vectors.c b/arch/arm/src/armv7-m/arm_vectors.c
--- a/arch/arm/src/armv7-m/arm_vectors.c
+++ b/arch/arm/src/armv7-m/arm_vectors.c
@@ -43,6 +43,7 @@
 #include "arm_internal.h"
 #include "ram_vectors.h"
 #include "nvic.h"
+#include "dwt.h"
 
 /****************************************************************************
  * Pre-processor Definitions
@@ -66,6 +67,110 @@ static void start(void)
                 "b  __start\n\t");
 }
 
+/* Temporary pre-scheduler core-fault capture.  The normal NuttX exception
+ * dispatcher cannot run this early because g_running_tasks is initialized
+ * later by nx_start().
+ */
+
+static void arm_early_puthex(uint32_t value)
+{
+  static const char hex[] = "0123456789abcdef";
+  int shift;
+
+  for (shift = 28; shift >= 0; shift -= 4)
+    {
+      arm_lowputc(hex[(value >> shift) & 0xf]);
+    }
+}
+
+void arm_early_fault_dump(uint32_t *frame, uint32_t exc_return,
+                          uint32_t exception)
+     noreturn_function noinline_function;
+
+void arm_early_fault_dump(uint32_t *frame, uint32_t exc_return,
+                          uint32_t exception)
+{
+  __asm__ volatile ("cpsid i" : : : "memory");
+
+  arm_lowputc('\r');
+  arm_lowputc('\n');
+  arm_lowputc('!');
+  arm_lowputc('E');
+  arm_early_puthex(exception);
+  arm_lowputc('C');
+  arm_early_puthex(getreg32(NVIC_CFAULTS));
+  arm_lowputc('H');
+  arm_early_puthex(getreg32(NVIC_HFAULTS));
+  arm_lowputc('D');
+  arm_early_puthex(getreg32(NVIC_DFAULTS));
+  arm_lowputc('A');
+  arm_early_puthex(getreg32(NVIC_AFAULTS));
+  arm_lowputc('V');
+  arm_early_puthex(getreg32(NVIC_VECTAB));
+  arm_lowputc('R');
+  arm_early_puthex(getreg32(NVIC_DEMCR));
+  arm_lowputc('K');
+  arm_early_puthex(getreg32(NVIC_DHCSR));
+  arm_lowputc('T');
+  arm_early_puthex(getreg32(DWT_CTRL));
+  arm_lowputc('0');
+  arm_early_puthex(getreg32(DWT_COMP0));
+  arm_lowputc('a');
+  arm_early_puthex(getreg32(DWT_FUNCTION0));
+  arm_lowputc('1');
+  arm_early_puthex(getreg32(DWT_COMP1));
+  arm_lowputc('b');
+  arm_early_puthex(getreg32(DWT_FUNCTION1));
+  arm_lowputc('2');
+  arm_early_puthex(getreg32(DWT_COMP2));
+  arm_lowputc('c');
+  arm_early_puthex(getreg32(DWT_FUNCTION2));
+  arm_lowputc('3');
+  arm_early_puthex(getreg32(DWT_COMP3));
+  arm_lowputc('d');
+  arm_early_puthex(getreg32(DWT_FUNCTION3));
+  arm_lowputc('B');
+  arm_early_puthex(getreg32(NVIC_BFAULT_ADDR));
+  arm_lowputc('M');
+  arm_early_puthex(getreg32(NVIC_MEMMANAGE_ADDR));
+  arm_lowputc('P');
+  arm_early_puthex(frame[6]);
+  arm_lowputc('L');
+  arm_early_puthex(frame[5]);
+  arm_lowputc('X');
+  arm_early_puthex(frame[7]);
+  arm_lowputc('S');
+  arm_early_puthex((uint32_t)(uintptr_t)frame);
+  arm_lowputc('Q');
+  arm_early_puthex(exc_return);
+  arm_lowputc('\r');
+  arm_lowputc('\n');
+
+  for (; ; )
+    {
+      __asm__ volatile ("nop");
+    }
+}
+
+void arm_early_fault(void) naked_function;
+
+void arm_early_fault(void)
+{
+  __asm__ volatile
+    (
+      "tst lr, #4\n"
+      "ite eq\n"
+      "mrseq r0, msp\n"
+      "mrsne r0, psp\n"
+      "tst lr, #16\n"
+      "it eq\n"
+      "addeq r0, r0, #72\n"
+      "mov r1, lr\n"
+      "mrs r2, ipsr\n"
+      "b arm_early_fault_dump\n"
+    );
+}
+
 /****************************************************************************
  * Public Functions
  ****************************************************************************/
@@ -101,7 +206,11 @@ const void * const _vectors[] locate_data(".vectors")
 
   /* Vectors 2 - n point directly at the generic handler */
 
-  [2 ... NVIC_IRQ_PENDSV] = &exception_common,
+  [NVIC_IRQ_NMI ... NVIC_IRQ_USAGEFAULT] = &arm_early_fault,
+  [(NVIC_IRQ_USAGEFAULT + 1) ... (NVIC_IRQ_SVCALL - 1)] = &exception_common,
+  [NVIC_IRQ_SVCALL] = &exception_common,
+  [NVIC_IRQ_DBGMONITOR] = &arm_early_fault,
+  [(NVIC_IRQ_DBGMONITOR + 1) ... NVIC_IRQ_PENDSV] = &exception_common,
   [(NVIC_IRQ_PENDSV + 1) ... (15 + ARMV7M_PERIPHERAL_INTERRUPTS)]
                           = &exception_direct
 };
