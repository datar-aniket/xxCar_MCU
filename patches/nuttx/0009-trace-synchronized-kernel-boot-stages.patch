diff --git a/arch/arm/src/stm32h7/stm32_lowputc.c b/arch/arm/src/stm32h7/stm32_lowputc.c
--- a/arch/arm/src/stm32h7/stm32_lowputc.c
+++ b/arch/arm/src/stm32h7/stm32_lowputc.c
@@ -335,9 +335,15 @@ void arm_lowputc(char ch)
 
   putreg32((uint32_t)ch, STM32_CONSOLE_BASE + STM32_USART_TDR_OFFSET);
 
-#ifdef STM32_CONSOLE_RS485_DIR
+  /* Diagnostic boot markers must reach the wire before early serial setup
+   * reconfigures this USART.  TXE only means TDR is empty; TC confirms that
+   * both TDR and the shift register are empty.
+   */
+
   while ((getreg32(STM32_CONSOLE_BASE + STM32_USART_ISR_OFFSET) &
           USART_ISR_TC) == 0);
+
+#ifdef STM32_CONSOLE_RS485_DIR
   stm32_gpiowrite(STM32_CONSOLE_RS485_DIR,
                   !STM32_CONSOLE_RS485_DIR_POLARITY);
 #endif
diff --git a/arch/arm/src/stm32h7/stm32_serial.c b/arch/arm/src/stm32h7/stm32_serial.c
--- a/arch/arm/src/stm32h7/stm32_serial.c
+++ b/arch/arm/src/stm32h7/stm32_serial.c
@@ -3832,6 +3832,8 @@ void arm_earlyserialinit(void)
 #ifdef HAVE_UART
   unsigned i;
 
+  arm_lowputc('J');
+
   /* Disable all USART interrupts */
 
   for (i = 0; i < STM32_NSERIAL; i++)
@@ -3839,13 +3841,17 @@ void arm_earlyserialinit(void)
       if (g_uart_devs[i])
         {
           up_disableusartint(g_uart_devs[i], NULL);
+          arm_lowputc('0' + i);
         }
     }
 
+  arm_lowputc('K');
+
   /* Configure whichever one is the console */
 
 #if CONSOLE_UART > 0
   up_setup(&g_uart_devs[CONSOLE_UART - 1]->dev);
+  arm_lowputc('L');
 #endif
 #endif /* HAVE UART */
 }
