+/****************************************************************************
+ * Public Types
+ ****************************************************************************/
+
+#ifdef CONFIG_SYSTEM_CLE_TABCOMPLETION
+/* TAB completion knows about the registered "builtin" applications by itself,
+ * but a shell also has commands of its own that are not builtins (NSH's ls, ps,
+ * cat and so on).  A shell may register this vtable to have those included in
+ * completion as well.  It mirrors readline's extmatch_vtable_s.
+ */
+
+struct cle_extmatch_vtable_s
+{
+  CODE int (*count_matches)(FAR char *name, FAR int *matches, int namelen);
+  CODE FAR const char *(*getname)(int index);
+};
+#endif
