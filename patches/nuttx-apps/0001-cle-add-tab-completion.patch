+/****************************************************************************
+ * Name: cle_appendtext
+ *
+ * Description:
+ *   Append a string at the cursor, as if it had been typed.
+ *
+ ****************************************************************************/
+
+static void cle_appendtext(FAR struct cle_s *priv, FAR const char *text)
+{
+  for (; *text != '\0'; text++)
+    {
+      cle_insertch(priv, *text);
+    }
+}
+
+/****************************************************************************
+ * Name: cle_countbuiltins
+ *
+ * Description:
+ *   Count the registered builtin applications whose names begin with the
+ *   first namelen characters of buf, recording their indices.
+ *
+ ****************************************************************************/
+
+static int cle_countbuiltins(FAR char *buf, FAR int *matches, int namelen)
+{
+#ifdef CONFIG_BUILTIN
+  FAR const char *name;
+  int nmatches = 0;
+  int i;
+
+  for (i = 0; (name = builtin_getname(i)) != NULL; i++)
+    {
+      if (strncmp(buf, name, namelen) == 0)
+        {
+          matches[nmatches++] = i;
+
+          if (nmatches >= CONFIG_SYSTEM_CLE_MAX_BUILTINS)
+            {
+              break;
+            }
+        }
+    }
+
+  return nmatches;
+#else
+  return 0;
+#endif
+}
+
+/****************************************************************************
+ * Name: cle_matchname
+ *
+ * Description:
+ *   The name of the i'th match, counting builtins first and then the shell's
+ *   own commands.
+ *
+ ****************************************************************************/
+
+static FAR const char *cle_matchname(int i, int nbuiltin,
+                                     FAR const int *builtins,
+                                     FAR const int *extcmds)
+{
+#ifdef CONFIG_BUILTIN
+  if (i < nbuiltin)
+    {
+      return builtin_getname(builtins[i]);
+    }
+#endif
+
+  if (g_extmatch_vtbl != NULL)
+    {
+      return g_extmatch_vtbl->getname(extcmds[i - nbuiltin]);
+    }
+
+  return NULL;
+}
+
+/****************************************************************************
+ * Name: cle_tabcompletion
+ *
+ * Description:
+ *   Complete the command name at the cursor.
+ *
+ *   One match completes it outright. Several are listed, and the line is
+ *   extended by however much they all agree on - so a TAB is never wasted even
+ *   when it cannot finish the job.
+ *
+ ****************************************************************************/
+
+static void cle_tabcompletion(FAR struct cle_s *priv)
+{
+  int builtins[CONFIG_SYSTEM_CLE_MAX_BUILTINS];
+  int extcmds[CONFIG_SYSTEM_CLE_MAX_EXTCMDS];
+  FAR const char *name;
+  int nbuiltin = 0;
+  int nextcmd  = 0;
+  int nmatches;
+  int len = priv->nchars;
+  int common;
+  int i;
+
+  /* Only the command is completed, and only when the cursor is at the end of
+   * it. Anything past a space is an argument, and we have no idea how to
+   * complete those - inserting a command name there would be worse than doing
+   * nothing.
+   */
+
+  if (len < 1 || priv->curpos != priv->nchars)
+    {
+      return;
+    }
+
+  for (i = 0; i < len; i++)
+    {
+      if (isspace((int)priv->line[i]))
+        {
+          return;
+        }
+    }
+
+  nbuiltin = cle_countbuiltins(priv->line, builtins, len);
+  nmatches = nbuiltin;
+
+  if (g_extmatch_vtbl != NULL)
+    {
+      nextcmd = g_extmatch_vtbl->count_matches(priv->line, extcmds, len);
+      nmatches += nextcmd;
+    }
+
+  if (nmatches < 1)
+    {
+      CLE_BEL(priv);
+      return;
+    }
+
+  /* How much of the completion do ALL the matches agree on? For one match that
+   * is the whole name; for several it is their common prefix, which is exactly
+   * how far we can safely type ahead for the user.
+   */
+
+  name   = cle_matchname(0, nbuiltin, builtins, extcmds);
+  common = name != NULL ? strlen(name) : 0;
+
+  for (i = 1; i < nmatches; i++)
+    {
+      FAR const char *other = cle_matchname(i, nbuiltin, builtins, extcmds);
+      int j;
+
+      if (other == NULL)
+        {
+          continue;
+        }
+
+      for (j = 0; j < common; j++)
+        {
+          if (name[j] != other[j])
+            {
+              break;
+            }
+        }
+
+      common = j;
+    }
+
+  /* More than one match: list them on their own line. The prompt and the line
+   * come back by themselves, because cle_showtext() redraws from column 0 on
+   * the next pass.
+   */
+
+  if (nmatches > 1)
+    {
+      cle_putch(priv, '\n');
+
+      for (i = 0; i < nmatches; i++)
+        {
+          FAR const char *match =
+            cle_matchname(i, nbuiltin, builtins, extcmds);
+
+          if (match != NULL)
+            {
+              cle_write(priv, match, strlen(match));
+              cle_putch(priv, ' ');
+              cle_putch(priv, ' ');
+            }
+        }
+
+      cle_putch(priv, '\n');
+
+      /* No need to reprint the prompt: cle_showtext() re-establishes the whole
+       * line - carriage return, clear, prompt, text - on the next pass.
+       */
+    }
+
+  /* Type in whatever the matches agreed on. With a single match that finishes
+   * the command; with several it advances as far as it can.
+   */
+
+  if (common > len && name != NULL)
+    {
+      cle_appendtext(priv, name + len);
+
+      /* An unambiguous command gets a space, so the next word can just be
+       * typed.
+       */
+
+      if (nmatches == 1)
+        {
+          cle_insertch(priv, ' ');
+        }
+    }
+  else if (nmatches == 1)
+    {
+      cle_insertch(priv, ' ');
+    }
+}
+#endif /* CONFIG_SYSTEM_CLE_TABCOMPLETION */
