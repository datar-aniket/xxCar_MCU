+ *
+ * Description:
+ *   Register a vtable that lets TAB completion see a shell's own commands, in
+ *   addition to the registered builtin applications.
+ *
+ * Returned Value:
+ *   The previously registered vtable (NULL if none).
+ *
+ ****************************************************************************/
+
+#ifdef CONFIG_SYSTEM_CLE_TABCOMPLETION
+FAR const struct cle_extmatch_vtable_s *
+  cle_extmatch(FAR const struct cle_extmatch_vtable_s *vtbl);
+#endif
