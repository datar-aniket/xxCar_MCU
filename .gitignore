# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.so.*


# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build directories
build/
Build/
build-*/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
!/Makefile
# Our own Makefiles are SOURCE, not generated: the board overlay's src/Makefile
# carries the CSRCS build list, and each app's Makefile declares its PROGNAME.
# Without these a clean clone builds neither the drivers nor the apps.
!/boards/fmuv6c/src/Makefile
!/apps/Makefile
!/apps/*/Makefile
install_manifest.txt
compile_commands.json

# NuttX build artifacts that land in-tree (apps/ and boards/ get these when the
# build runs against the symlinked source dirs).
.built
.depend
.kconfig
Make.dep

# Temporary files
*.tmp
*.log
*.bak
*.swp

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/

# NuttX out-of-tree board build artifacts
boards/*/src/.depend
boards/*/src/Make.dep
boards/*/src/*.o

# apps/Kconfig is generated by nuttx-apps' Directory.mk at configure time, and
# it hardcodes ABSOLUTE paths to each app's Kconfig. Committing it would bake
# one machine's home directory into the repo, and it churns every time an app is
# added. The build regenerates it, so it must not be tracked.
/apps/Kconfig
__pycache__/
