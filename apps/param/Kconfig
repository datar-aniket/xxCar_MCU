#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config XXCAR_PARAM
	tristate "param: configuration parameter system"
	default n
	---help---
		Typed, bounded, named parameters with defaults. FMUv6C persists them
		to microSD as human-readable text. MatekH743 uses the final two
		internal-flash sectors and optionally mirrors them to the SD card.

		Backs the serial port functions (incl. which port runs NSH), RC
		protocol, sensor rates, MAVLink IDs, logging selection and sensor
		calibration.

if XXCAR_PARAM

config XXCAR_PARAM_PROGNAME
	string "Program name"
	default "param"

config XXCAR_PARAM_PRIORITY
	int "param task priority"
	default 100

config XXCAR_PARAM_STACKSIZE
	int "param stack size"
	default 4096

endif
