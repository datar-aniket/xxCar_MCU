config XXCAR_SD_STATUS
	tristate "sd_status: live SDMMC and IDMA diagnostics"
	default n
	depends on MMCSD && STM32H7_SDMMC2
	---help---
		Report the live SDMMC2 clock/bus configuration, block geometry and
		low-overhead transfer/error counters without modifying the data path.

if XXCAR_SD_STATUS

config XXCAR_SD_STATUS_PROGNAME
	string "Program name"
	default "sd_status"

config XXCAR_SD_STATUS_PRIORITY
	int "Task priority"
	default 100

config XXCAR_SD_STATUS_STACKSIZE
	int "Stack size"
	default 2048

endif
