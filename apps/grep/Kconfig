#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config XXCAR_GREP
	tristate "grep: print the lines that contain a string"
	default n
	---help---
		Print the lines of a file - or of standard input - that contain a
		string:

		  dmesg | grep serial
		  ps | grep px4io
		  grep -i SER_ /fs/microsd/params.txt

		Supports -i, -v, -n, -c and -q. PATTERN is a plain string, not a
		regular expression: a regex engine is a lot of flash for a tool
		whose job here is to find a word in a log.

		Piping needs NSH_PIPELINE (and so PIPES).

if XXCAR_GREP

config XXCAR_GREP_PROGNAME
	string "Program name"
	default "grep"

config XXCAR_GREP_PRIORITY
	int "grep task priority"
	default 100

config XXCAR_GREP_STACKSIZE
	int "grep stack size"
	default 3072

endif
